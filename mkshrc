# translate some shorthands into find options
translate() {
typeset opt

# default to name
if [ "$#" -eq 1 ]; then
printf "-name '%s'" "$1"
shift
fi

while ! [ -z "$1" ]; do
opt="$1"
shift
case "$opt" in
-n)
printf "-name "
;;
-*)
printf "%s " "$opt"
;;
*)
printf "'%s' " "$opt"
;;
esac
done
}

# Rodrigo Monteiro Junior - Tue Apr 28 15:16:47 -03 2026
dir() {
typeset path="$(pwd)"
typeset filter="-not -name '.*'"

while ! [ -z "$1" ] ; do
case "$1" in
-f)
;;
*)
path="$(realpath "$1")"
shift
;;
esac

if [ "$1" = "-f" ]; then
shift
filter="$(translate "$@")"
fi

break
done

# out:

eval "find '${path}' -maxdepth 1 ${filter}"
}
