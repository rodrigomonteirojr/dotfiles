[global]
    # Notification window geometry: center-top, 300px wide, dynamic height
    origin = top-center
    offset = (0, 20)
    width = 300
    height = (0, 300)      # adapt to content
    notification_limit = 5

    # Rounded corners for all notifications
    corner_radius = 12

    # Default font (matching JWM tray font)
    font = Sans-12

    # Other sensible defaults
    frame_width = 2
    frame_color = "#66BB6A"
    separator_color = frame
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 4
    icon_position = off       # no icons for these text-only statuses
    hide_text = false
    markup = full

    # Mouse actions (optional)
    mouse_left_click = close_current
    mouse_right_click = close_all

# Rule for the speech command program
[speech-commander]
    # Match notifications sent by "Talon" (or whatever the app name is)
    appname = "Talon"

    # Override appearance
    background = "#F1F8E9"
    foreground = "#2E7D32"
    frame_color = "#66BB6A"

    # Status notifications should stay visible until replaced or closed
    timeout = 0        # never auto-dismiss
    override_pause_level = 100

    # Make the format show summary and body prominently
    format = "<b>%s</b>\n%b"

    # Optional: hide duplicate count (useful if you ever stack)
    # hide_duplicate_count = true
